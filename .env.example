# Copy to .env.local for local development; set the same keys in Vercel.

# Public site URL (used for canonical, Open Graph and JSON-LD URLs).
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=

# Analytics: each script loads only when its ID is set.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Enquiry storage. Without these, submissions are logged to the server
# console and the visitor still sees the success state (demo mode).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enquiries allowed per IP per 10 minutes (default 5).
ENQUIRY_RATE_LIMIT=
